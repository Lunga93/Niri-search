{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/schema.json",
  "productName": "Niri-Search",
  "version": "0.1.0",
  "identifier": "com.look.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Niri-Search",
        "width": 860,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "resizable": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Keyboard-first launcher for the Niri compositor",
    "longDescription": "Niri-Search is a keyboard-first, local-first launcher built for Niri. Find and open apps, files, folders, clipboard history, and run quick commands without leaving the keyboard.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0",
          "libglib2.0-0",
          "libcairo2",
          "libpango-1.0-0",
          "libgdk-pixbuf-2.0-0",
          "libharfbuzz0b",
          "libdbus-1-3",
          "libasound2",
          "xdg-desktop-portal"
        ],
        "recommends": ["libgtk-layer-shell0"],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsoup3",
          "glib2",
          "cairo",
          "pango",
          "gdk-pixbuf2",
          "harfbuzz",
          "dbus-libs",
          "alsa-lib",
          "xdg-desktop-portal"
        ],
        "recommends": ["gtk-layer-shell"]
      }
    }
  },
  "plugins": {}
}
