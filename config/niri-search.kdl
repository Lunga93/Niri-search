// Niri-Search integration for the Niri compositor.
//
// This file lives OUTSIDE config.kdl and is pulled in with `include`.
// Do NOT copy it into config.kdl itself: niri allows only one top-level
// `binds` block per file, and `include` is how the bind lines get merged
// into your existing binds. Setup, one of:
//   1. Run the installer (writes this file + adds the include line):
//        install-niri-search.sh --configure-niri
//   2. Save as ~/.config/niri/niri-search.kdl and add to config.kdl:
//        include "/home/YOU/.config/niri/niri-search.kdl";
//
// Afterwards run `niri validate`. The binary is `lookapp` and the D-Bus
// name is `com.look.Desktop` (code identifiers, unchanged by the rebrand).

// Start the background service on login. The window itself is summoned
// with the bind below; it hides instead of quitting.
// Prefer the absolute binary path here: login sessions often lack
// ~/.local/bin on PATH and a bare "lookapp" would silently fail to start
// (the installer writes the absolute path for this reason).
spawn-at-startup "lookapp"

binds {
    // allow-inhibiting=false matters: without it niri passes the key to a
    // window holding a keyboard-shortcuts inhibitor (fullscreen games,
    // browsers, VMs all take one) and the launcher never opens over them.
    Alt+Space allow-inhibiting=false hotkey-overlay-title="Niri-Search" { spawn "gdbus" "call" "--session" "--dest" "com.look.Desktop" "--object-path" "/com/look/Desktop" "--method" "com.look.Desktop.Toggle"; }

    // Global quit, even while the launcher is hidden (the in-window
    // Alt+Shift+Q only works when the overlay is focused).
    Alt+Shift+Q allow-inhibiting=false { spawn "gdbus" "call" "--session" "--dest" "com.look.Desktop" "--object-path" "/com/look/Desktop" "--method" "com.look.Desktop.Quit"; }
}

// Floating is applied at runtime over niri's IPC; this rule only adds the
// focus-ring/shadow treatment on top.
window-rule {
    match app-id="^lookapp$"
    open-floating true
    focus-ring { off; }
    shadow { off; }
}
